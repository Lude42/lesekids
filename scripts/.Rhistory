mutate(n_sub = n() ) %>%
group_by(subject_id, item) %>%
mutate(n_sub_item = n() ) %>%
ungroup() %>%
filter(n_item > 30 & n_sub > 5 & n_sub_item <= 1) %>%
mutate(rt2 = log(rt/1000),
