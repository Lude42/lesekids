# estimate.R
setwd("C:/Users/mulrlude/Documents/App lesekids/lesekids_projekt/lesekids/scripts")
#setwd("/home/appuser/lesekids/scripts")
rm(list = ls())
library(DBI)
library(RSQLite)  # oder RPostgres, je nach DB
library(TAM)
library(tidyr)
library(dplyr)
library(lme4)
# 1. DB-Verbindung
con <- dbConnect(SQLite(), "../data/test.db")  # Pfad zur DB
# 2. Daten laden
dataIr <- dbGetQuery(con, "SELECT subject_id, item, day, score
FROM clean_responses")
dataRt <- dbGetQuery(con, "SELECT subject_id, item, DATE(timestamp) AS day, rt, correct
FROM clean_resp_first WHERE question_type = 'mc'" )
itemStack <- dbGetQuery(con, "SELECT item, type AS question_type FROM item_contents")
dbDisconnect(con)
# IR Data
wdataIr <- dataIr %>%
group_by(item) %>%
mutate(n_item = n() ) %>%
group_by(subject_id, day) %>%
mutate(n_sub = n() ) %>%
group_by(subject_id, item) %>%
mutate(n_sub_item = n() ) %>%
ungroup() %>%
filter(n_item > 30 & n_sub > 5 & n_sub_item <= 1) %>%
mutate(score = ifelse(score == 1, 0, ifelse(score == 2, 1, score)) ) %>%
select(-n_item, -n_sub, -n_sub_item ) %>%
tidyr::pivot_wider(names_from = item,
values_from = score, values_fill = NA) %>%
dplyr::select(-subject_id, -day)
# 4. Modell schätzen
modelIr <- TAM::tam.mml(as.matrix(wdataIr), verbose = F)
write.csv2(data.frame(item =  modelIr$item$item, modelIr$xsi), file = "parameters.csv")
# 5. item flags
modelIrFit  <- IRT.itemfit(modelIr)
itemFit <- modelIrFit$RMSD %>%
mutate(RMSD = Group1, item = as.integer(item)) %>%
select(item, RMSD)
itemParResp<- data.frame(item = as.integer(row.names(modelIr$xsi)),
xsi = modelIr$xsi$xsi,
se.xsi = modelIr$xsi$se.xsi)
# ----------------------------------------------------------
# Lasso-Modell zur Vorhersage von Item-Parametern (xsi)
# und Empirical-Bayes-Kombination mit IRT-Schätzungen
# ----------------------------------------------------------
# Pakete ---------------------------------------------------
library(dplyr)
library(glmnet)
# Daten einlesen --------------------------------------------
# Erwartet:
load("./item_merkmale.Rdata")   # lädt u.a. Objekt 'icov'
# Merge: IRT-Parameter + Kovariablen ------------------------
wrk <- itemParResp %>%
dplyr::select(item, xsi, se.xsi) %>%
right_join(icov, by = "item")
# Designmatrix aller Items (auch ohne xsi) ------------------
X_all <- wrk %>%
dplyr::select(-item, -xsi, -se.xsi) %>%
as.matrix()
# Nur Items mit vorhandener IRT-Schätzung für das Training ---
X_exist <- X_all[!is.na(wrk$xsi), ]
y       <- wrk$xsi[!is.na(wrk$xsi)]
# ----------------------------------------------------------
# 1) Repeated Cross-Validation zur Schätzung der
#    Prognose-Varianz (sigma_pred)
# ----------------------------------------------------------
set.seed(123)
K <- 10          # Anzahl Folds
R <- 20          # Anzahl Wiederholungen
n <- length(y)
mse_1se <- numeric(R)
for (r in seq_len(R)) {
# Zufällige Fold-Zuteilung
foldid <- sample(rep(seq_len(K), length.out = n))
# CV-Lasso
cv_fit <- cv.glmnet(
X_exist, y,
alpha  = 1,        # alpha = 1 -> Lasso
foldid = foldid
)
# MSE bei lambda.1se
idx_1se    <- which(cv_fit$lambda == cv_fit$lambda.1se)[1]
mse_1se[r] <- cv_fit$cvm[idx_1se]
}
# Geschätzte Prognose-Standardabweichung
sigma_pred <- sqrt(mean(mse_1se))
# ----------------------------------------------------------
# 2) finales Lasso-Modell (einmalige CV mit allen Daten)
# ----------------------------------------------------------
cv_model    <- cv.glmnet(X_exist, y, alpha = 1)
best_lambda <- cv_model$lambda.1se
final_model <- glmnet(
X_exist, y,
alpha  = 1,
lambda = best_lambda
)
# Vorhergesagte xsi für alle Items (auch ohne IRT-Schätzung)
xsi_pred_all <- predict(final_model, newx = X_all)[, 1]
# ----------------------------------------------------------
# 3) Empirical-Bayes-Kombination: IRT-Schätzung + Prediction
# ----------------------------------------------------------
itemParResp2 <- wrk %>%
mutate(
# Vorhersage aus dem Lasso
xsi_pred   = xsi_pred_all,
sigma_pred = sigma_pred,
# Gewichte: 1 / Varianz
w_irt  = 1 / (se.xsi^2),
w_pred = 1 / (sigma_pred^2),
# EB-Schätzer (Kombination von IRT und Prediction)
xsi2   = (w_irt * xsi + w_pred * xsi_pred) / (w_irt + w_pred),
var_eb   = 1 / (w_irt + w_pred),
sexsi2 = sqrt(var_eb),
# Für Items ohne IRT-Schätzung nur die Prediction verwenden
xsi2   = ifelse(is.na(xsi),  xsi_pred,  xsi2),
sexsi2 = ifelse(is.na(xsi), sigma_pred, sexsi2)
) %>%
dplyr::select(
item,
xsi, se.xsi,      # ursprüngliche IRT-Schätzungen
xsi_pred, sigma_pred,
xsi2, sexsi2  # EB-Schätzer
)
#find SST and SSE
y = itemParResp2[!is.na(itemParResp2$xsi),]$xsi
y_predicted = itemParResp2[!is.na(itemParResp2$xsi),]$xsi_pred
sst <- sum((y - mean(y))^2)
sse <- sum((y_predicted - y)^2)
rsq <- 1 - sse/sst
# Bearbeitungszeit
wdataRt <- dataRt %>% group_by(item) %>%
mutate(n_item = n() ) %>%
group_by(subject_id, day) %>%
mutate(n_sub = n() ) %>%
group_by(subject_id, item) %>%
mutate(n_sub_item = n() ) %>%
ungroup() %>%
filter(n_item > 30 & n_sub > 5 & n_sub_item <= 1) %>%
mutate(rt2 = log(rt/1000),
rt2 = ifelse(rt2 > 6, 6, rt2),
item =factor(item) )
modelRt <- lmer(rt2 ~ -1 + item +(1 |day:subject_id),
data = wdataRt )
paramTime <- coefficients(summary(modelRt))
itemParTime <- data.frame(item = as.integer(substring(row.names(paramTime), 5,8)),
timeIntensity = paramTime[,1],
seTimeIntensity = paramTime[,2]
)
## Modelparemeter
modelParams <- data.frame(IrVar = modelIr$variance,
IrRel = modelIr$EAP.rel,
RtTau2 = data.frame(VarCorr(modelRt))%>%
filter(grp=="day:subject_id") %>% pull(vcov),
RtSigma2 = sigma(modelRt)^2,
R2_pred = rsq,
estDate = format(as.POSIXct(Sys.time(), tz = "UTC"),
"%Y-%m-%dT%H:%M:%OS3Z")
)
# 6. Itemparameter extrahieren
params <- modelIr$item %>%
mutate(item = as.integer(item) ) %>%
merge(.,itemParResp2, by = "item", all.y = T) %>%
merge(.,itemFit, by = "item", all.x = T) %>%
merge(.,itemParTime, by = "item",all.x = T) %>%
merge(.,itemStack, by = "item", all = T) %>%
mutate(
item = as.integer(item),
N = as.integer(ifelse(is.na(N), 0, N)),
threshold_2 = ifelse(xsi2 < -5,-5,
ifelse(xsi2 > 2,2,
xsi2)),
xsipv = threshold_2 + purrr::map_dbl(sexsi2,function(x) rnorm(1, mean = 0 , sd = x)  ),
threshold_2pv = ifelse(xsipv < -5,-5,
ifelse(xsipv > 2,2,
xsipv)),
threshold_1 = threshold_2-2 + rnorm(length(threshold_2),mean = 0, 0.5 ),
weight = ifelse(is.na(N) | is.na(RMSD),1,
ifelse(N > 150 & RMSD > 0.08,0,1 )),
tmp = ifelse(N < 50, max(item), NA),
points_first_try = as.integer(20 + ntile(threshold_2, n = 80)),### Problem, schwelle zu hoch
points_later_try = as.integer(round(points_first_try/2)),###
first_threshold = as.integer(2000),
timeIntensity = ifelse(is.na(timeIntensity),
mean(itemParTime$timeIntensity),timeIntensity),
seTimeIntensity = ifelse(is.na(seTimeIntensity),
sigma(modelRt)^2,seTimeIntensity),
estDate = format(as.POSIXct(Sys.time(), tz = "UTC"),
"%Y-%m-%dT%H:%M:%OS3Z")#,
#estDate = "2025-11-08T15:08:46.999Z"
) %>%
select(item, N, M, threshold_1, threshold_2pv, threshold_2,
sexsi2, timeIntensity, seTimeIntensity, RMSD,
weight, estDate,
points_first_try, points_later_try,
first_threshold, tmp)
View(params)
