library(DBI)
library(RSQLite)  # oder RPostgres, je nach DB
library(readxl)
# 1. DB-Verbindung
con <- dbConnect(SQLite(), "../lesekids/data/test.db")  # Pfad zur DB
library(tidyr)
library(dplyr)
wrk_txt<- read_excel("itempool_online_in_database.xlsx") %>%
mutate(item = as.integer(item),
cor = as.integer(cor)
updated_at = format(as.POSIXct(Sys.time(), tz = "UTC"),
wrk_txt<- read_excel("itempool_online_in_database.xlsx") %>%
mutate(item = as.integer(item),
cor = as.integer(cor),
updated_at = format(as.POSIXct(Sys.time(), tz = "UTC"),
"%Y-%m-%dT%H:%M:%OS3Z"))
View(wrk_txt)
View(wrk_txt)
# 1) Daten prüfen/aufräumen
wrk_txt$item <- as.integer(wrk_txt$item)
stopifnot(!anyDuplicated(wrk_txt$item))  # kein Duplicate-Key
stopifnot(!any(is.na(wrk_txt$item)))     # kein NA-Key
# 6. Tabelle löschen und neu schreiben
dbExecute(con, "DROP TABLE IF EXISTS item_contents")
intersect(c("cor"), names(wrk_txt))
names(wrk_txt)
int_cols
text_cols <- setdiff(names(wrk_txt), c("item", int_cols))
text_cols
create_sql <- paste0(
"CREATE TABLE item_contents (",
" item INTEGER PRIMARY KEY, ",
paste(sprintf(' "%s" INTEGER ', int_cols), collapse = ", "),
if (length(int_cols) > 0 && length(text_cols) > 0) ", " else "",
paste(sprintf(' "%s" TEXT ', text_cols), collapse = ", "),
");"
)
dbExecute(con, create_sql)
# 3) Daten einfügen (spaltenweise per Namen)
dbWriteTable(con, "item_contents", wrk_txt, append = TRUE,
row.names = FALSE)
# 7. Verbindung schließen
dbDisconnect(con)
# 6. Tabelle löschen und neu schreiben
dbExecute(con, "DROP TABLE IF EXISTS item_contents")
