mutate(item = as.integer(item) ) %>%
merge(.,itemParResp2, by = "item", all.y = T) %>%
merge(.,itemFit, by = "item", all.x = T) %>%
merge(.,itemParTime, by = "item",all.x = T) %>%
merge(.,itemStack, by = "item", all = T) %>%
mutate(
item = as.integer(item),
N = as.integer(ifelse(is.na(N), 0, N)),
threshold_2 = ifelse(xsi2 < -5,-5,
ifelse(xsi2 > 2,2,
xsi2)),
xsipv = threshold_2 + purrr::map_dbl(sexsi2,function(x) rnorm(1, mean = 0 , sd = x)  ),
threshold_2pv = ifelse(xsipv < -5,-5,
ifelse(xsipv > 2,2,
xsipv)),
threshold_1 = threshold_2-2 + rnorm(length(threshold_2),mean = 0, 0.5 ),
weight = ifelse(is.na(N) | is.na(RMSD),1,
ifelse(N > 150 & RMSD > 0.08,0,1 )),
tmp = ifelse(N < 50, max(item), NA),
points_first_try = as.integer(20 + ntile(threshold_2, n = 80)),### Problem, schwelle zu hoch
points_later_try = as.integer(round(points_first_try/2)),###
first_threshold = as.integer(2000),
timeIntensity = ifelse(is.na(timeIntensity),
mean(itemParTime$timeIntensity),timeIntensity),
seTimeIntensity = ifelse(is.na(seTimeIntensity),
sigma(modelRt)^2,seTimeIntensity),
